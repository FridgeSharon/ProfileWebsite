{
  "name": "profile-website",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run start:dev --workspace backend\" \"npm start --workspace frontend\"",
    "seed": "npm run seed --workspace backend",
    "build": "npm run build --workspace backend && npm run build --workspace frontend",
    "build:frontend": "cd frontend && npm run build",
    "build:pages": "cd frontend && npm run build",
    "lint": "npm run lint --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "brace-expansion": "5.0.8",
    "minimatch": "10.2.5",
    "glob": "13.0.6",
    "uuid": "11.1.1",
    "postcss": "8.5.23",
    "@hono/node-server": "2.0.12",
    "webpack-dev-server": "5.2.6"
  }
}
