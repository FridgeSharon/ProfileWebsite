{
  "name": "frontend",
  "version": "0.0.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node -e \"if(process.env.BACKEND_URL) { require('fs').mkdirSync('dist/frontend/browser', {recursive: true}); require('fs').writeFileSync('dist/frontend/browser/_redirects', '/api/* ' + process.env.BACKEND_URL + '/api/:splat 200\\n'); }\"",
    "watch": "ng build --watch --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.0.8",
    "@angular/compiler": "^22.0.8",
    "@angular/core": "^22.0.8",
    "@angular/forms": "^22.0.8",
    "@angular/platform-browser": "^22.0.8",
    "@angular/router": "^22.0.8",
    "rxjs": "^7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.8",
    "@types/node": "^24.0.0",
    "typescript": "~6.0.2"
  }
}
